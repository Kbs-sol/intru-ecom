---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getOrders } from "@/lib/db";

const db = Astro.locals.runtime?.env?.DB;
let orders = [];
if (db) {
  orders = await getOrders(db);
}

const statusColors: Record<string, { bg: string; color: string }> = {
  pending: { bg: "#fef3c7", color: "#92400e" },
  paid: { bg: "#dcfce7", color: "#166534" },
  shipped: { bg: "#dbeafe", color: "#1e40af" },
  delivered: { bg: "#f3e8ff", color: "#6b21a8" },
  cancelled: { bg: "#fee2e2", color: "#991b1b" },
};
---

<AdminLayout title="Orders">
  <p style="color:#666; font-size:13px; margin-bottom:24px;">{orders.length} total orders</p>

  <div style="background:white; border-radius:4px; overflow:hidden;">
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:13px;">
        <thead>
          <tr style="background:#f8f8f8; border-bottom:2px solid #e5e5e5;">
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Order ID</th>
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Customer</th>
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Items</th>
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Total</th>
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Status</th>
            <th style="text-align:left; padding:12px 16px; font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#666;">Date</th>
          </tr>
        </thead>
        <tbody>
          {orders.length === 0 ? (
            <tr>
              <td colspan="6" style="text-align:center; padding:48px; color:#999; font-size:13px;">No orders yet</td>
            </tr>
          ) : orders.map((order) => {
            const statusStyle = statusColors[order.status] || { bg: "#f3f4f6", color: "#374151" };
            let itemCount = 0;
            try {
              const items = JSON.parse(order.items);
              itemCount = items.reduce((sum: number, i: { qty: number }) => sum + i.qty, 0);
            } catch {}

            return (
              <tr style="border-bottom:1px solid #f0f0f0;">
                <td style="padding:12px 16px; font-family:monospace; font-size:11px; color:#666;">{order.id.slice(0, 20)}...</td>
                <td style="padding:12px 16px;">
                  <div style="font-weight:500;">{order.customer_name}</div>
                  <div style="font-size:11px; color:#999;">{order.customer_email}</div>
                  {order.customer_phone && <div style="font-size:11px; color:#999;">{order.customer_phone}</div>}
                </td>
                <td style="padding:12px 16px; font-size:12px; color:#666;">{itemCount} item{itemCount !== 1 ? 's' : ''}</td>
                <td style="padding:12px 16px; font-weight:600;">₹{order.total.toLocaleString("en-IN")}</td>
                <td style="padding:12px 16px;">
                  <select
                    onchange={`updateStatus('${order.id}', this.value)`}
                    style={`font-size:10px; padding:4px 8px; border:none; text-transform:uppercase; letter-spacing:0.1em; font-weight:600; background:${statusStyle.bg}; color:${statusStyle.color}; cursor:pointer; outline:none;`}
                  >
                    {["pending","paid","shipped","delivered","cancelled"].map((s) => (
                      <option value={s} selected={s === order.status}>{s}</option>
                    ))}
                  </select>
                </td>
                <td style="padding:12px 16px; font-size:11px; color:#999;">{new Date(order.created_at).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  async function updateStatus(orderId, status) {
    try {
      await fetch("/api/admin/orders/status", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: orderId, status }),
      });
    } catch {
      alert("Failed to update status");
    }
  }
</script>
