---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSession } from "@/lib/auth";

const secret = import.meta.env.AUTH_SECRET || "";
const session = await getSession(Astro.request, secret);

if (session) {
  return Astro.redirect("/");
}

const googleClientId = import.meta.env.GOOGLE_CLIENT_ID || "";
const redirect = Astro.url.searchParams.get("redirect") || "/";
---

<BaseLayout title="Login — intru.in" noindex={true}>
  <div class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <div class="text-center mb-10">
        <a href="/" class="font-outfit font-black text-3xl text-white tracking-widest uppercase hover:text-brand-red transition-colors">
          intru
        </a>
        <p class="text-zinc-500 font-inter text-sm mt-2">Sign in to your account</p>
      </div>

      <div x-data="{ tab: 'login', error: '', loading: false }">
        <!-- Google login -->
        <a
          href={`/api/auth/google?redirect=${encodeURIComponent(redirect)}`}
          class="flex items-center justify-center gap-3 w-full bg-white text-gray-900 py-3.5 px-4 font-inter font-medium text-sm hover:bg-gray-100 transition-colors duration-200 mb-6"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continue with Google
        </a>

        <div class="flex items-center gap-3 mb-6">
          <div class="flex-1 h-px bg-zinc-800"></div>
          <span class="text-zinc-600 text-xs font-inter">or</span>
          <div class="flex-1 h-px bg-zinc-800"></div>
        </div>

        <!-- Tabs -->
        <div class="flex border border-zinc-800 mb-6">
          <button
            x-on:click="tab = 'login'"
            x-bind:class="tab === 'login' ? 'bg-white text-black' : 'text-zinc-500 hover:text-white'"
            class="flex-1 py-2.5 text-xs font-outfit tracking-widest uppercase transition-all duration-150"
          >
            Sign In
          </button>
          <button
            x-on:click="tab = 'register'"
            x-bind:class="tab === 'register' ? 'bg-white text-black' : 'text-zinc-500 hover:text-white'"
            class="flex-1 py-2.5 text-xs font-outfit tracking-widest uppercase transition-all duration-150"
          >
            Create Account
          </button>
        </div>

        <!-- Error -->
        <p x-show="error" x-text="error" class="text-red-400 text-sm mb-4 font-inter text-center"></p>

        <!-- Login form -->
        <form
          x-show="tab === 'login'"
          x-on:submit.prevent="submit('login')"
          class="space-y-4"
        >
          <div>
            <label class="text-zinc-400 text-xs font-outfit tracking-wider uppercase mb-2 block">Email</label>
            <input type="email" name="email" required class="input-field" placeholder="you@example.com" autocomplete="email" />
          </div>
          <div>
            <label class="text-zinc-400 text-xs font-outfit tracking-wider uppercase mb-2 block">Password</label>
            <input type="password" name="password" required class="input-field" placeholder="••••••••" autocomplete="current-password" />
          </div>
          <button
            type="submit"
            x-bind:disabled="loading"
            class="btn-primary w-full"
          >
            <span x-show="!loading">Sign In</span>
            <span x-show="loading">Signing in...</span>
          </button>
        </form>

        <!-- Register form -->
        <form
          x-show="tab === 'register'"
          x-on:submit.prevent="submit('register')"
          class="space-y-4"
        >
          <div>
            <label class="text-zinc-400 text-xs font-outfit tracking-wider uppercase mb-2 block">Name</label>
            <input type="text" name="name" required class="input-field" placeholder="Your Name" autocomplete="name" />
          </div>
          <div>
            <label class="text-zinc-400 text-xs font-outfit tracking-wider uppercase mb-2 block">Email</label>
            <input type="email" name="email" required class="input-field" placeholder="you@example.com" autocomplete="email" />
          </div>
          <div>
            <label class="text-zinc-400 text-xs font-outfit tracking-wider uppercase mb-2 block">Password</label>
            <input type="password" name="password" required minlength="8" class="input-field" placeholder="Min. 8 characters" autocomplete="new-password" />
          </div>
          <button
            type="submit"
            x-bind:disabled="loading"
            class="btn-primary w-full"
          >
            <span x-show="!loading">Create Account</span>
            <span x-show="loading">Creating account...</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ redirect }} is:inline>
  function loginApp() {
    return {};
  }

  // Attach submit to Alpine
  document.addEventListener("alpine:init", () => {
    Alpine.data("loginForm", () => ({
      tab: "login",
      error: "",
      loading: false,

      async submit(type) {
        this.error = "";
        this.loading = true;
        const form = this.$el;
        const data = new FormData(form);
        const body = Object.fromEntries(data.entries());

        try {
          const res = await fetch(`/api/auth/${type}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const result = await res.json();
          if (!res.ok) throw new Error(result.error || "Something went wrong");
          window.location.href = redirect || "/";
        } catch (err) {
          this.error = err.message;
          this.loading = false;
        }
      },
    }));
  });
</script>
