---
import BaseLayout from "@/layouts/BaseLayout.astro";

const orderId = Astro.url.searchParams.get("order") || "";
---

<BaseLayout title="Order Confirmed — intru.in" noindex={true}>
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <div class="w-20 h-20 bg-brand-red/10 border border-brand-red/30 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-outfit font-black text-3xl text-white tracking-wide mb-4">Order Confirmed!</h1>
      <p class="text-zinc-400 font-inter text-sm leading-relaxed mb-6">
        Your order has been placed successfully. We'll send you a confirmation email shortly.
      </p>
      {orderId && (
        <p class="text-zinc-600 text-xs font-inter mb-8">Order ID: <span class="text-zinc-400 font-mono">{orderId}</span></p>
      )}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products" class="btn-primary inline-block">Continue Shopping</a>
        <a href="/" class="btn-secondary inline-block">Back to Home</a>
      </div>
    </div>
  </div>
</BaseLayout>
