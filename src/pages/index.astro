---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { getFeaturedProducts } from "@/lib/db";
import { formatPrice } from "@/lib/utils";
import { withBase } from "@/lib/config";

const db = Astro.locals.runtime?.env?.DB;
let featuredProducts = [];
if (db) {
  featuredProducts = await getFeaturedProducts(db);
}

const orgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://intru.in/#organization",
      name: "intru.in",
      url: "https://intru.in",
      logo: "https://intru.in/favicon.svg",
      sameAs: ["https://instagram.com/intru.in"],
      description: "Premium minimal streetwear brand based in India.",
    },
    {
      "@type": "WebSite",
      "@id": "https://intru.in/#website",
      url: "https://intru.in",
      name: "intru.in",
      publisher: { "@id": "https://intru.in/#organization" },
      potentialAction: {
        "@type": "SearchAction",
        target: "https://intru.in/products?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<BaseLayout
  title="intru.in — Premium Minimal Streetwear"
  description="Shop premium minimal streetwear at intru.in. Heavyweight tees, hoodies, cargos and sets crafted for those who move with purpose. Free shipping on prepaid orders."
  schema={orgSchema}
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-brand-black">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-red/20 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl">
        <div class="overflow-hidden mb-2">
          <p class="text-brand-red text-xs font-outfit tracking-widest uppercase animate-fade-up" style="animation-delay:0.1s; opacity:0; fill-mode:forwards;">
            New Collection — 2025
          </p>
        </div>
        <div class="overflow-hidden">
          <h1 class="font-outfit font-black text-6xl sm:text-8xl md:text-9xl text-white leading-none tracking-tight animate-fade-up" style="animation-delay:0.2s; opacity:0; animation-fill-mode:forwards;">
            WEAR
          </h1>
        </div>
        <div class="overflow-hidden">
          <h1 class="font-outfit font-black text-6xl sm:text-8xl md:text-9xl leading-none tracking-tight animate-fade-up" style="animation-delay:0.35s; opacity:0; animation-fill-mode:forwards; -webkit-text-stroke: 2px #d73f3f; color: transparent;">
            PURPOSE.
          </h1>
        </div>
        <div class="overflow-hidden mt-6">
          <p class="text-zinc-400 font-inter text-lg md:text-xl max-w-lg leading-relaxed animate-fade-up" style="animation-delay:0.5s; opacity:0; animation-fill-mode:forwards;">
            Minimal streetwear built to outlast trends. Heavyweight fabrics, clean cuts, zero noise.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 mt-10 animate-fade-up" style="animation-delay:0.65s; opacity:0; animation-fill-mode:forwards;">
          <a href={withBase("/products")} class="btn-primary inline-block text-center">
            Shop Collection
          </a>
          <a href={withBase("/about")} class="btn-secondary inline-block text-center">
            Our Story
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Trust badges -->
  <section class="bg-zinc-950 border-y border-zinc-900 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { icon: "🚚", text: "Free Shipping", sub: "On prepaid above ₹999" },
          { icon: "↩", text: "Easy Returns", sub: "7-day return window" },
          { icon: "🔒", text: "Secure Payment", sub: "Razorpay encrypted" },
          { icon: "📦", text: "Cash on Delivery", sub: "Available pan-India" },
        ].map((badge) => (
          <div class="flex flex-col items-center gap-1">
            <span class="text-2xl">{badge.icon}</span>
            <p class="text-white font-outfit font-semibold text-xs tracking-wider uppercase">{badge.text}</p>
            <p class="text-zinc-500 text-xs font-inter">{badge.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  {featuredProducts.length > 0 && (
    <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-brand-red text-xs font-outfit tracking-widest uppercase mb-2">Featured</p>
          <h2 class="section-title text-3xl md:text-4xl">The Edit</h2>
        </div>
        <a href={withBase("/products")} class="btn-ghost hidden sm:block">View All →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
      <div class="text-center mt-10 sm:hidden">
        <a href={withBase("/products")} class="btn-secondary inline-block">View All Products</a>
      </div>
    </section>
  )}

  <!-- Static product grid fallback (when no DB) -->
  {featuredProducts.length === 0 && (
    <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-brand-red text-xs font-outfit tracking-widest uppercase mb-2">New Arrivals</p>
          <h2 class="section-title text-3xl md:text-4xl">The Collection</h2>
        </div>
        <a href={withBase("/products")} class="btn-ghost hidden sm:block">View All →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {[
          { name: "Intru Classic Tee", price: 999, og: 1299, img: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600&q=80", slug: "intru-classic-tee" },
          { name: "Intru Oversized Drop", price: 1299, og: 1599, img: "https://images.unsplash.com/photo-1562157873-818bc0726f68?w=600&q=80", slug: "intru-oversized-drop" },
          { name: "Intru Essential Hoodie", price: 1999, og: 2499, img: "https://images.unsplash.com/photo-1556821840-3a63f15732ce?w=600&q=80", slug: "intru-essential-hoodie" },
        ].map((p) => (
          <a href={withBase(`/products/${p.slug}`)} class="group block bg-zinc-900 overflow-hidden hover:scale-[1.02] transition-transform duration-300">
            <div class="aspect-[3/4] overflow-hidden">
              <img src={p.img} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            </div>
            <div class="p-4">
              <h3 class="font-outfit font-semibold text-white text-xs tracking-wider uppercase">{p.name}</h3>
              <div class="flex gap-2 mt-1">
                <span class="text-white text-sm">{formatPrice(p.price)}</span>
                <span class="text-zinc-500 line-through text-xs">{formatPrice(p.og)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Brand story excerpt -->
  <section class="py-20 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-brand-red text-xs font-outfit tracking-widest uppercase mb-4">About intru</p>
          <h2 class="font-outfit font-black text-4xl md:text-5xl text-white leading-tight mb-6">
            Designed for<br />
            <span style="-webkit-text-stroke: 1px #d73f3f; color: transparent;">rebels.</span>
          </h2>
          <p class="text-zinc-400 font-inter text-base leading-relaxed mb-4">
            intru was born from a simple frustration: great fits shouldn't cost a fortune. We started in a room, with a vision for clothing that looks premium, feels premium, and lasts longer than fast fashion.
          </p>
          <p class="text-zinc-400 font-inter text-base leading-relaxed mb-8">
            Every piece we make is a deliberate choice — heavyweight fabrics, minimal branding, and cuts designed to stand the test of time.
          </p>
          <a href={withBase("/about")} class="btn-secondary inline-block">Read Our Story</a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-[3/4] bg-zinc-900 overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=400&q=80"
              alt="intru brand"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="aspect-[3/4] bg-zinc-900 overflow-hidden mt-8">
            <img
              src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=400&q=80"
              alt="intru collection"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery marquee -->
  <section class="py-12 overflow-hidden">
    <div class="gallery-track">
      {Array(8).fill(null).map((_, i) => (
        <div class="w-56 h-72 flex-shrink-0 overflow-hidden bg-zinc-900">
          <img
            src={[
              "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=400&q=70",
              "https://images.unsplash.com/photo-1503341504253-dff4815485f1?w=400&q=70",
              "https://images.unsplash.com/photo-1516912481808-3406841bd33c?w=400&q=70",
              "https://images.unsplash.com/photo-1495105787522-5334e3ffa0ef?w=400&q=70",
              "https://images.unsplash.com/photo-1550614000-4895a10e1bfd?w=400&q=70",
              "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&q=70",
              "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=400&q=70",
              "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=400&q=70",
            ][i % 8]}
            alt="intru lookbook"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-up {
    animation: fade-up 0.7s ease-out forwards;
  }
</style>
