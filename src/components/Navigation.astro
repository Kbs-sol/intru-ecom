---
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-brand-black/95 backdrop-blur-sm border-b border-zinc-900"
  x-data="{ mobileOpen: false }"
  style="margin-top: 32px;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="font-outfit font-black text-2xl text-white tracking-widest uppercase hover:text-brand-red transition-colors duration-200">
        intru
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/products" class="nav-link">Shop</a>
        <a href="/about" class="nav-link">Our Story</a>
        <a href="/legal/shipping" class="nav-link">Shipping</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-4">
        <!-- Cart button -->
        <button
          x-on:click="$store.cart.open = true"
          class="relative flex items-center gap-2 text-white hover:text-brand-red transition-colors duration-200"
          aria-label="Open cart"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            x-show="$store.cart.count > 0"
            x-text="$store.cart.count"
            class="absolute -top-2 -right-2 bg-brand-red text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center"
          ></span>
          <span class="hidden sm:inline text-xs font-outfit tracking-widest uppercase">Bag</span>
        </button>

        <!-- Login / Account -->
        <div x-data="{ loggedIn: false }" x-init="loggedIn = !!document.cookie.match(/intru_session/)">
          <a
            x-show="!loggedIn"
            href="/auth/login"
            class="text-xs font-outfit tracking-widest uppercase text-brand-gray hover:text-white transition-colors duration-200"
          >
            Login
          </a>
          <a
            x-show="loggedIn"
            href="/auth/account"
            class="text-xs font-outfit tracking-widest uppercase text-brand-gray hover:text-white transition-colors duration-200"
          >
            Account
          </a>
        </div>

        <!-- Mobile menu toggle -->
        <button
          class="md:hidden text-white"
          x-on:click="mobileOpen = !mobileOpen"
          aria-label="Toggle menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path x-show="!mobileOpen" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            <path x-show="mobileOpen" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav -->
    <div
      x-show="mobileOpen"
      x-transition
      class="md:hidden border-t border-zinc-900 py-4 flex flex-col gap-4"
    >
      <a href="/products" class="nav-link px-2">Shop All</a>
      <a href="/about" class="nav-link px-2">Our Story</a>
      <a href="/legal/shipping" class="nav-link px-2">Shipping</a>
      <a href="/legal/returns" class="nav-link px-2">Returns</a>
    </div>
  </div>
</header>

<!-- Spacer for fixed nav (announcement bar 32px + nav 64px) -->
<div class="h-24"></div>
