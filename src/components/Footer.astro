---
import { withBase } from "@/lib/config";
---

<footer class="bg-zinc-950 border-t border-zinc-900 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href={withBase("/")} class="font-outfit font-black text-3xl text-white tracking-widest uppercase hover:text-brand-red transition-colors duration-200">
          intru
        </a>
        <p class="text-zinc-500 text-sm leading-relaxed mt-4 font-inter">
          Minimal streetwear crafted for those who move with purpose. Every thread tells a story.
        </p>
        <div class="flex gap-4 mt-6">
          <a href="https://instagram.com/intru.in" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-white transition-colors duration-200" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Shop -->
      <div>
        <h4 class="font-outfit font-semibold text-xs tracking-widest uppercase text-white mb-6">Shop</h4>
        <ul class="space-y-3">
          <li><a href={withBase("/products")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">All Products</a></li>
          <li><a href={withBase("/products?cat=tshirts")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">T-Shirts</a></li>
          <li><a href={withBase("/products?cat=hoodies")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Hoodies</a></li>
          <li><a href={withBase("/products?cat=bottoms")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Bottoms</a></li>
          <li><a href={withBase("/products?cat=sets")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Sets</a></li>
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h4 class="font-outfit font-semibold text-xs tracking-widest uppercase text-white mb-6">Info</h4>
        <ul class="space-y-3">
          <li><a href={withBase("/about")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Our Story</a></li>
          <li><a href={withBase("/legal/shipping")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Shipping Policy</a></li>
          <li><a href={withBase("/legal/returns")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Returns & Exchanges</a></li>
          <li><a href={withBase("/auth/login")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">My Account</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-outfit font-semibold text-xs tracking-widest uppercase text-white mb-6">Legal</h4>
        <ul class="space-y-3">
          <li><a href={withBase("/legal/privacy")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Privacy Policy</a></li>
          <li><a href={withBase("/legal/terms")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Terms & Conditions</a></li>
          <li><a href={withBase("/legal/returns")} class="text-zinc-500 hover:text-white text-sm transition-colors duration-200">Return Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-zinc-900 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-zinc-600 text-xs font-inter">
        © {new Date().getFullYear()} intru.in — All rights reserved
      </p>
      <div class="flex items-center gap-4">
        <img src="https://razorpay.com/favicon.ico" alt="Razorpay" class="h-4 opacity-50" />
        <span class="text-zinc-600 text-xs">Secured payments by Razorpay</span>
      </div>
    </div>
  </div>
</footer>
