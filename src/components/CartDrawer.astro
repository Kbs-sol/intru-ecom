---
---

<!-- Overlay -->
<div
  x-data
  x-show="$store.cart.open"
  x-on:click="$store.cart.open = false"
  x-transition:enter="transition-opacity duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition-opacity duration-300"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 bg-black/70 z-50"
  style="display:none;"
></div>

<!-- Drawer -->
<div
  x-data
  x-show="$store.cart.open"
  x-transition:enter="transform transition-transform duration-300 ease-out"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transform transition-transform duration-300 ease-in"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  class="fixed top-0 right-0 h-full w-full sm:w-96 bg-zinc-950 border-l border-zinc-800 z-50 flex flex-col"
  style="display:none;"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-800">
    <h2 class="font-outfit font-bold text-white tracking-widest uppercase text-sm">
      Your Bag
      <span class="text-brand-red ml-2" x-text="`(${$store.cart.count})`"></span>
    </h2>
    <button
      x-on:click="$store.cart.open = false"
      class="text-zinc-400 hover:text-white transition-colors duration-200"
      aria-label="Close cart"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Items -->
  <div class="flex-1 overflow-y-auto px-6 py-4">
    <!-- Empty state -->
    <div x-show="$store.cart.items.length === 0" class="flex flex-col items-center justify-center h-full text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-zinc-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <p class="text-zinc-500 font-inter text-sm">Your bag is empty</p>
      <a
        href="/products"
        x-on:click="$store.cart.open = false"
        class="mt-4 text-xs font-outfit tracking-widest uppercase text-brand-red hover:text-red-400 transition-colors"
      >
        Shop Now →
      </a>
    </div>

    <!-- Cart items -->
    <template x-for="item in $store.cart.items" :key="item.key">
      <div class="flex gap-4 py-4 border-b border-zinc-800/50">
        <img
          :src="item.image"
          :alt="item.name"
          class="w-16 h-20 object-cover bg-zinc-900"
        />
        <div class="flex-1 min-w-0">
          <h3 class="text-white font-outfit font-semibold text-xs tracking-wider uppercase truncate" x-text="item.name"></h3>
          <p class="text-zinc-400 text-xs mt-0.5">Size: <span x-text="item.size"></span></p>
          <p class="text-white font-inter text-sm font-medium mt-1" x-text="$store.cart.formatPrice(item.price)"></p>
          <div class="flex items-center gap-3 mt-2">
            <div class="flex items-center border border-zinc-700">
              <button
                x-on:click="$store.cart.updateQty(item.key, item.qty - 1)"
                class="w-7 h-7 flex items-center justify-center text-zinc-400 hover:text-white transition-colors"
              >
                −
              </button>
              <span class="w-8 text-center text-xs text-white" x-text="item.qty"></span>
              <button
                x-on:click="$store.cart.updateQty(item.key, item.qty + 1)"
                class="w-7 h-7 flex items-center justify-center text-zinc-400 hover:text-white transition-colors"
              >
                +
              </button>
            </div>
            <button
              x-on:click="$store.cart.remove(item.key)"
              class="text-zinc-600 hover:text-red-400 text-xs transition-colors"
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Footer -->
  <div x-show="$store.cart.items.length > 0" class="border-t border-zinc-800 px-6 py-5 space-y-3">
    <div class="flex justify-between text-sm">
      <span class="text-zinc-400 font-inter">Subtotal</span>
      <span class="text-white font-inter font-medium" x-text="$store.cart.formatPrice($store.cart.subtotal)"></span>
    </div>
    <div class="flex justify-between text-xs">
      <span class="text-zinc-500 font-inter">Shipping</span>
      <span class="text-zinc-400 font-inter" x-text="$store.cart.subtotal >= 999 ? 'FREE' : '₹99'"></span>
    </div>
    <div class="flex justify-between border-t border-zinc-800 pt-3">
      <span class="text-white font-outfit font-semibold tracking-wider uppercase text-sm">Total</span>
      <span class="text-white font-outfit font-bold text-lg" x-text="$store.cart.formatPrice($store.cart.total)"></span>
    </div>
    <a
      href="/checkout"
      class="block w-full bg-brand-red text-white text-center py-4 font-outfit font-bold tracking-widest uppercase text-sm hover:bg-red-700 transition-colors duration-200"
    >
      Checkout
    </a>
    <button
      x-on:click="$store.cart.open = false"
      class="block w-full text-center text-xs font-outfit tracking-widest uppercase text-zinc-500 hover:text-white transition-colors py-1"
    >
      Continue Shopping
    </button>
  </div>
</div>
